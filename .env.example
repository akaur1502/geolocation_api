# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Get a free ipstack key at https://ipstack.com/ and set it below.

# Your ipstack API key (required for real lookups)
IPSTACK_API_KEY=your_ipstack_key_here

# Bearer token required by the API's endpoints.
# Defaults to "dev-local-token" if unset, so the app runs out of the box.
API_TOKEN=dev-local-token

# PostgreSQL credentials for the local/Docker database (safe local defaults).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
